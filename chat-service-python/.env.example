# ==================== 服务配置 ====================
# 服务监听地址
HOST=0.0.0.0
# 服务端口
PORT=8000
# Worker进程数（生产环境建议设置为CPU核心数）
WORKERS=1
# 运行环境：dev开发环境/prod生产环境
ENV=dev

# ==================== 数据库配置 ====================
# PostgreSQL数据库配置
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat_service
# 同步数据库URL（用于初始化建表）
DB_URL_SYNC=postgresql://postgres:postgres@localhost:5432/chat_service

# ==================== 日志配置 ====================
# 日志文件保存路径
LOG_PATH=logs/server.log
# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# ==================== LLM配置 ====================
# OpenAI API密钥（必填）
OPENAI_API_KEY=sk-your-api-key-here
# OpenAI API基础URL（可选，默认使用官方地址）
OPENAI_BASE_URL=https://api.openai.com/v1
# 默认使用的模型
DEFAULT_MODEL=gpt-3.5-turbo
# LLM请求超时时间（秒）
LLM_TIMEOUT=60
# LLM温度参数（0-2，值越大输出越随机）
LLM_TEMPERATURE=0.7
# 最大生成token数
LLM_MAX_TOKENS=2000

# ==================== 其他配置 ====================
# 文件保存路径
FILE_SAVE_PATH=files/
# 是否启用CORS跨域（开发环境建议开启）
ENABLE_CORS=true
