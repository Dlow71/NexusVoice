# NexusVoice MySQL 8.0 配置文件
# 针对 Spring Boot + MyBatis-Plus 优化

[mysqld]
# 基础配置
user = mysql
pid-file = /var/run/mysqld/mysqld.pid
socket = /var/run/mysqld/mysqld.sock
port = 3306
basedir = /usr
datadir = /var/lib/mysql
tmpdir = /tmp
lc-messages-dir = /usr/share/mysql

# 字符集配置
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4'

# SQL 模式配置
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# 连接配置
max_connections = 1000
max_connect_errors = 100000
max_user_connections = 500

# 超时配置
wait_timeout = 28800
interactive_timeout = 28800
connect_timeout = 60
net_read_timeout = 30
net_write_timeout = 60

# 缓冲区配置
innodb_buffer_pool_size = 256M
innodb_buffer_pool_instances = 1
innodb_log_buffer_size = 32M
innodb_log_file_size = 128M
innodb_log_files_in_group = 2

# InnoDB 配置
innodb_file_per_table = 1
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_lock_wait_timeout = 50
innodb_rollback_on_timeout = ON
innodb_print_all_deadlocks = 1

# 查询缓存（MySQL 8.0 已移除查询缓存）
# query_cache_type = 0
# query_cache_size = 0

# 临时表配置
tmp_table_size = 64M
max_heap_table_size = 64M

# MyISAM 配置（尽管主要使用 InnoDB）
key_buffer_size = 32M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
sort_buffer_size = 8M
join_buffer_size = 8M

# 二进制日志配置
log-bin = mysql-bin
binlog_format = ROW
binlog_row_image = FULL
sync_binlog = 1
expire_logs_days = 7
max_binlog_size = 100M

# 错误日志
log-error = /var/log/mysql/error.log

# 慢查询日志
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1
log_throttle_queries_not_using_indexes = 10

# 一般查询日志（开发环境可启用，生产环境建议关闭）
general_log = 0
general_log_file = /var/log/mysql/general.log

# 服务器ID（用于主从复制）
server-id = 1

# 表名大小写敏感性（Linux 下建议设置为 1）
lower_case_table_names = 0

# 跳过域名解析（提高连接速度）
skip-name-resolve

# 跳过外部锁定
skip-external-locking

# 最大允许的数据包大小
max_allowed_packet = 64M

# 线程配置
thread_cache_size = 16
thread_stack = 512K

# 表缓存
table_open_cache = 4096
table_definition_cache = 4096

# 性能模式
performance_schema = ON

[mysql]
# MySQL 客户端配置
default-character-set = utf8mb4

[client]
# 客户端配置
default-character-set = utf8mb4
port = 3306
socket = /var/run/mysqld/mysqld.sock
