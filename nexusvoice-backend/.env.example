# NexusVoice Backend - Docker Compose 环境变量配置文件
# 
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据你的实际情况修改以下配置
# 3. 运行 docker-compose up -d 启动服务
#
# 重要提示：
# - .env 文件包含敏感信息，不应提交到版本控制系统
# - 生产环境请务必修改所有默认密码和密钥
# - 所有以 _KEY 或 _PASSWORD 结尾的变量都应该设置为强密码

# ===========================================
# 应用基础配置
# ===========================================
# Spring Boot 运行环境 (docker, dev, test, prod)
SPRING_PROFILES_ACTIVE=docker

# 应用端口配置
APP_PORT=8080
APP_DEBUG_PORT=5005

# JVM 配置
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# JVM 调试配置 (true/false)
JVM_DEBUG=false
JVM_DEBUG_SUSPEND=n

# ===========================================
# 数据库配置 (MySQL)
# ===========================================
# MySQL 数据库连接信息
DB_NAME=nexusvoice_dev
DB_USERNAME=nexusvoice
DB_PASSWORD=nexusvoice123

# MySQL 端口
MYSQL_PORT=3306

# MySQL Root 密码（用于管理员访问）
MYSQL_ROOT_PASSWORD=root123

# ===========================================
# Redis 缓存配置
# ===========================================
# Redis 端口
REDIS_PORT=6379

# Redis 密码（留空表示无密码）
REDIS_PASSWORD=

# Redis 数据库索引 (0-15)
REDIS_DATABASE=0

# Redis 数据库数量
REDIS_DATABASES=16

# ===========================================
# JWT 认证配置
# ===========================================
# JWT 密钥（生产环境请使用复杂的随机字符串）
JWT_SECRET=nexusvoice-jwt-secret-key-change-in-production-environment

# JWT 令牌过期时间（毫秒）
# 24小时 = 86400000 毫秒
JWT_EXPIRATION=86400000

# JWT 刷新令牌过期时间（毫秒）
# 7天 = 604800000 毫秒
JWT_REFRESH_EXPIRATION=604800000

# JWT 签发者
JWT_ISSUER=nexusvoice

# ===========================================
# LangChain4j AI 配置
# ===========================================
# 是否启用 LangChain4j 功能 (true/false)
LANGCHAIN4J_ENABLED=true

# OpenAI API 配置
# 请在 https://platform.openai.com/api-keys 获取 API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API 基础 URL (可以使用代理或第三方服务)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型配置
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ===========================================
# 搜索服务配置
# ===========================================
# 搜索提供商 (duckduckgo, tavily)
SEARCH_PROVIDER=tavily

# Tavily 搜索 API Key
# 请在 https://tavily.com 注册获取 API Key
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ===========================================
# TTS 文本转语音配置
# ===========================================
# 七牛云 TTS API Token
TTS_TOKEN=your-qiniu-tts-token-here

# TTS 默认音色
TTS_VOICE_TYPE=qiniu_zh_female_wwxkjx

# ===========================================
# 图像生成配置 (硅基流动)
# ===========================================
# 硅基流动 API Key
# 请在 https://siliconflow.cn 注册获取 API Key
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# 硅基流动 API 基础 URL
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===========================================
# 七牛云存储配置
# ===========================================
# 七牛云存储凭证
# 请在七牛云控制台获取 Access Key 和 Secret Key
QINIU_ACCESS_KEY=your-qiniu-access-key-here
QINIU_SECRET_KEY=your-qiniu-secret-key-here

# 七牛云存储空间配置
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=your-cdn-domain.com

# ===========================================
# 管理工具配置
# ===========================================
# phpMyAdmin 端口
PHPMYADMIN_PORT=8082

# Redis Commander 配置（可选工具）
REDIS_COMMANDER_PORT=8083
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# ===========================================
# 开发和调试配置
# ===========================================
# 是否启用 SQL 日志 (true/false)
ENABLE_SQL_LOG=true

# 是否启用 Druid 监控 (true/false)
ENABLE_DRUID_MONITOR=true

# 是否启用 Actuator 端点 (true/false)
ENABLE_ACTUATOR=true

# 指定 MyBatis 日志实现类（覆盖 ENABLE_SQL_LOG）
# 可选：org.apache.ibatis.logging.stdout.StdOutImpl 或 org.apache.ibatis.logging.nologging.NoLoggingImpl
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl

# Mapper 包日志级别（覆盖 ENABLE_SQL_LOG）
# 可选：TRACE, DEBUG, INFO, WARN, ERROR, OFF
MAPPER_LOG_LEVEL=DEBUG

# Actuator 暴露端点列表（逗号分隔）
# 例如：health,info 或 health,info,metrics,prometheus,druid
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus,druid

# ===========================================
# 高级配置
# ===========================================
# Docker 网络子网
DOCKER_SUBNET=172.20.0.0/16

# 容器时区
TZ=Asia/Shanghai

# 文件上传限制 (MB)
MAX_FILE_SIZE=100

# 请求体大小限制 (MB)
MAX_REQUEST_SIZE=100

# ===========================================
# 生产环境安全配置
# ===========================================
# 生产环境请启用以下安全配置

# HTTPS 配置
# SSL_ENABLED=true
# SSL_KEY_STORE=classpath:keystore.p12
# SSL_KEY_STORE_PASSWORD=your-keystore-password
# SSL_KEY_STORE_TYPE=PKCS12

# 跨域配置
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=*

# 限流配置
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=100

# 监控配置
# MONITORING_ENABLED=true
# METRICS_EXPORT_PROMETHEUS=true
