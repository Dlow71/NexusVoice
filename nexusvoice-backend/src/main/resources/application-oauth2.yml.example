# OAuth2客户端配置示例
# 请复制此文件为 application-local.yml 并填入实际的OAuth应用信息

spring:
  security:
    oauth2:
      client:
        registration:
          # GitHub OAuth配置
          github:
            # 从GitHub OAuth App获取的Client ID
            client-id: ${GITHUB_CLIENT_ID:your_github_client_id_here}
            # 从GitHub OAuth App获取的Client Secret（严格保密）
            client-secret: ${GITHUB_CLIENT_SECRET:your_github_client_secret_here}
            # 授权范围：读取用户信息和邮箱
            scope: 
              - read:user
              - user:email
            # 重定向URI，必须与GitHub OAuth App中配置的一致
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            # 授权方式
            authorization-grant-type: authorization_code
            # 客户端名称（显示用）
            client-name: GitHub
            
          # Google OAuth配置（可选，未来扩展）
          # google:
          #   client-id: ${GOOGLE_CLIENT_ID:your_google_client_id}
          #   client-secret: ${GOOGLE_CLIENT_SECRET:your_google_client_secret}
          #   scope:
          #     - email
          #     - profile
          #   redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
          #   authorization-grant-type: authorization_code
          #   client-name: Google
            
        provider:
          # GitHub提供商配置
          github:
            # 授权端点
            authorization-uri: https://github.com/login/oauth/authorize
            # 令牌端点
            token-uri: https://github.com/login/oauth/access_token
            # 用户信息端点
            user-info-uri: https://api.github.com/user
            # 用户名属性（用户信息中的哪个字段作为用户名）
            user-name-attribute: id
            
          # Google提供商配置（可选）
          # google:
          #   authorization-uri: https://accounts.google.com/o/oauth2/v2/auth
          #   token-uri: https://oauth2.googleapis.com/token
          #   user-info-uri: https://www.googleapis.com/oauth2/v3/userinfo
          #   user-name-attribute: sub
          #   jwk-set-uri: https://www.googleapis.com/oauth2/v3/certs

# OAuth2成功/失败重定向配置
oauth2:
  success:
    redirect:
      # 登录成功后重定向到前端的URL
      url: ${OAUTH2_SUCCESS_REDIRECT_URL:http://localhost:5173/oauth/callback}
  failure:
    redirect:
      # 登录失败后重定向到前端的URL
      url: ${OAUTH2_FAILURE_REDIRECT_URL:http://localhost:5173/login}

# 如何配置GitHub OAuth App:
# 1. 登录GitHub -> Settings -> Developer settings -> OAuth Apps
# 2. 点击 "New OAuth App"
# 3. 填写以下信息：
#    - Application name: NexusVoice
#    - Homepage URL: http://localhost:5173 (开发环境) 或 https://your-domain.com (生产环境)
#    - Authorization callback URL: http://localhost:8081/login/oauth2/code/github (开发环境)
#                                  或 https://api.your-domain.com/login/oauth2/code/github (生产环境)
# 4. 创建后获取 Client ID 和 Client Secret
# 5. 将它们填入此配置文件

# 安全注意事项:
# 1. 永远不要将 Client Secret 提交到Git仓库
# 2. 使用环境变量管理敏感信息
# 3. 生产环境必须使用HTTPS
# 4. 定期轮换Client Secret
# 5. 限制OAuth App的权限范围到最小必需
