# gRPC到RTP TTS桥接进程 - Dockerfile

FROM python:3.11-slim

# 安装GStreamer
RUN apt-get update && apt-get install -y \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 \
    libcairo2-dev \
    libgirepository1.0-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements.txt .

# 安装Python依赖
RUN pip3 install --no-cache-dir -r requirements.txt

# 复制Proto文件
COPY ../nexusvoice-backend/src/main/proto/*.proto ./proto/

# 生成gRPC Python代码
RUN mkdir -p generated && \
    python3 -m grpc_tools.protoc \
    -I./proto \
    --python_out=./generated \
    --grpc_python_out=./generated \
    ./proto/common.proto \
    ./proto/asr_service.proto \
    ./proto/tts_service.proto && \
    touch generated/__init__.py

# 复制桥接程序
COPY grpc2rtp_tts.py .

# 启动命令
ENTRYPOINT ["python3", "grpc2rtp_tts.py"]
CMD ["--grpc-host", "localhost", "--grpc-port", "50052", "--rtp-host", "127.0.0.1", "--rtp-port", "50061", "--session-id", "default"]






